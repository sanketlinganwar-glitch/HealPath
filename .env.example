# MediCare Server Configuration
PORT=3000
NODE_ENV=development
JWT_SECRET=medicare_hackathon_super_secret_jwt_key_2026

# MySQL Database (Optional - leaves empty to run zero-config atomic storage engine)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=medicare_db

# WhatsApp Cloud API (Meta for Developers)
# If left blank, the app operates in intelligent Simulation Mode with UI notifications
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_ID=

# Twilio WhatsApp API (Alternative provider)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Admin Configuration
ADMIN_SLOT_DURATION_MIN=15
ADMIN_GRACE_PERIOD_MIN=10

# QR Check-in HMAC Secret
QR_SECRET=healpath_qr_checkin_secret_key_2026
# Fast2SMS API Configuration (SMS Fallback)
# If left blank, SMS operates in Simulation Mode (logged to messages log with channel "sms-sim")
FAST2SMS_API_KEY=

# Demo Mode Reminder Minutes Override (e.g. 3 to test reminders for slots 3 minutes away)
DEMO_REMINDER_MINUTES=

# Razorpay Online Payment Configuration (TEST MODE ONLY - Must start with rzp_test_)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
