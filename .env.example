# MediCare Server Configuration
PORT=3000
NODE_ENV=development
JWT_SECRET=medicare_hackathon_super_secret_jwt_key_2026

# MySQL Database (Optional - leaves empty to run zero-config atomic storage engine)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=medicare_db

# WhatsApp Cloud API (Meta for Developers)
# If left blank, the app operates in intelligent Simulation Mode with UI notifications
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_ID=

# Twilio WhatsApp API (Alternative provider)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Admin Configuration
ADMIN_SLOT_DURATION_MIN=15
ADMIN_GRACE_PERIOD_MIN=10
